import std.process.{Process, executeWithOutput}
import std.fs.removeIfExists

// Run a native build command and preserve its diagnostics in cjpm's log.
func run(command: String, arguments: Array<String>): Int64 {
    let (status, stdout, stderr) = executeWithOutput(command, arguments)
    if (stdout.size > 0) {
        print(String.fromUtf8(stdout))
    }
    if (stderr.size > 0) {
        eprint(String.fromUtf8(stderr))
    }
    return status
}

func stagePreBuild(): Int64 {
    // Build a static library so cjpm does not need a runtime library path.
    let compileStatus = run("cc", [
        "-std=c11", "-Wall", "-Wextra", "-Werror", "-pedantic",
        "-c", "native/tree_flatten.c", "-o", "native/tree_flatten.o"
    ])
    if (compileStatus != 0) {
        return compileStatus
    }
    return run("ar", ["rcs", "native/libtree_flatten.a", "native/tree_flatten.o"])
}

func stagePreClean(): Int64 {
    // Remove only the native artifacts generated by this build script.
    removeIfExists("native/tree_flatten.o")
    removeIfExists("native/libtree_flatten.a")
    return 0
}

main(): Int64 {
    match (Process.current.arguments[0]) {
        case "pre-build" => stagePreBuild()
        case "pre-clean" => stagePreClean()
        case _ => 0
    }
}
